# MongoDB Connection
# Set either MONGODB_URI or DATABASE_URL
MONGODB_URI=
# For MongoDB Atlas:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/optics_store?retryWrites=true&w=majority

# JWT Secret (use a random value with at least 32 characters)
JWT_SECRET=

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080
